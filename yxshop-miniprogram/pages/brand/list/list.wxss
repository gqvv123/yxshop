/* pages/brand/list — 品牌专区 */
.brand-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 50%, var(--primary-light) 100%);
  padding: 0 0 32rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  position: relative;
  z-index: 2;
}
.sb-input {
  flex: 1;
  font-size: 26rpx;
  color: #fff;
}
.sb-ph { color: rgba(255, 255, 255, 0.6); }
.sb-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 品牌网格 */
.brand-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
}
.brand-card {
  width: calc((100% - 40rpx) / 3);
  background: var(--card);
  border-radius: var(--r-md);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: var(--shadow-sm);
}
.bc-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-sm);
  background: var(--bg-soft);
}
.bc-logo--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary);
  background: var(--primary-50);
}
.bc-name {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text-1);
  max-width: 100%;
  text-align: center;
}
.bc-desc {
  font-size: 20rpx;
  color: var(--text-3);
  max-width: 100%;
  text-align: center;
}

/* 状态 */
.state-box {
  margin: 100rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.sb-text {
  font-size: 26rpx;
  color: var(--text-3);
}
.sb-btn {
  margin-top: 8rpx;
  padding: 14rpx 44rpx;
  border-radius: var(--r-full);
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-size: 26rpx;
}
