/* order/confirm — 企业级订单确认页（蓝色渐变风格） */
.confirm-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 180rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 40rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* ========== 地址卡片 ========== */
.address-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: -24rpx 24rpx 0;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 3;
}
.address-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  background: repeating-linear-gradient(
    90deg,
    var(--primary) 0,
    var(--primary) 20rpx,
    var(--accent) 20rpx,
    var(--accent) 40rpx,
    var(--success) 40rpx,
    var(--success) 60rpx
  );
  border-radius: 0 0 var(--r-lg) var(--r-lg);
}
/* 地址主体：姓名/电话一行，详细地址一行（横排会让姓名被挤到换行） */
.addr-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.addr-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.addr-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  flex-shrink: 0;
  white-space: nowrap;
}
.addr-phone {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.addr-detail {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.addr-empty {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-3);
}

/* ========== 商品卡片 ========== */
.goods-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: 20rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-sm);
}
.gc-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
}
.goods-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}
.goods-item + .goods-item {
  border-top: 2rpx solid var(--line-light);
}
.goods-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-md);
  flex-shrink: 0;
  background: var(--bg-soft);
}
.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.goods-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.4;
}
.goods-spec {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.goods-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--price);
}
.goods-qty {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ========== 表单卡片 ========== */
.form-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: 20rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-sm);
}
.fc-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.fc-input {
  font-size: 28rpx;
  color: var(--text-1);
}
.ph {
  color: var(--text-3);
}

/* 配送方式 */
.delivery-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.delivery-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--line-light);
  border-radius: var(--r-md);
  background: var(--bg);
  transition: all 0.15s;
}
.delivery-item.active {
  border-color: var(--primary);
  background: rgba(59, 130, 246, 0.06);
}
.di-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}
.di-name {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
}
.di-desc {
  font-size: 22rpx;
  color: var(--text-3);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
}
.freight-line {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--r-sm);
  background: rgba(16, 185, 129, 0.08);
}
.fl-text {
  font-size: 22rpx;
  color: #10b981;
}

/* 支付方式 */
.pay-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pay-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.po-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-1);
}

/* ========== 合计 ========== */
.summary-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: 20rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-sm);
}
.sum-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--text-1);
}
.sum-row.sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.sum-price {
  font-weight: 700;
  color: var(--price);
}
.sum-discount {
  font-weight: 700;
  color: var(--price);
}
.calc-hint {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ========== 优惠券 / 会员行 ========== */
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.coupon-row + .coupon-row {
  border-top: 2rpx solid var(--line-light);
}
.cr-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cr-label {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
}
.cr-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.cr-value {
  font-size: 26rpx;
  color: var(--price);
  font-weight: 600;
}
.cr-placeholder {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ========== 优惠券选择弹层 ========== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease;
  z-index: 900;
}
.sheet-mask.show {
  opacity: 1;
  visibility: visible;
}
.coupon-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 72vh;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 901;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.coupon-sheet.show {
  transform: translateY(0);
}
.cs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}
.cs-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}
.cs-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cs-body {
  max-height: 54vh;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.cs-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--line-light);
  border-radius: var(--r-md);
  background: var(--bg);
}
.cs-item.active {
  border-color: var(--primary);
  background: rgba(59, 130, 246, 0.06);
}
.cs-item.none {
  justify-content: space-between;
}
.ci-left {
  width: 150rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx dashed var(--line);
  padding-right: 16rpx;
}
.ci-amount {
  display: flex;
  align-items: baseline;
  color: var(--price);
}
.ci-symbol {
  font-size: 22rpx;
  font-weight: 700;
}
.ci-num {
  font-size: 40rpx;
  font-weight: 800;
  margin-left: 2rpx;
}
.ci-threshold {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.ci-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ci-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
}
.ci-tip {
  font-size: 22rpx;
  color: var(--text-3);
}
.cs-footer {
  padding: 16rpx 32rpx 24rpx;
  text-align: center;
}
.cs-count {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
  z-index: 100;
}
.bb-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.bb-price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--price);
}
.bb-submit {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  padding: 0 56rpx;
  height: 80rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.25);
}
.bb-submit.disabled {
  opacity: 0.6;
}
