<view class="page">
  <block wx:if="{{detail}}">
    <!-- 活动头部 -->
    <view class="hero">
      <view class="hero-title">{{detail.title || '促销活动'}}</view>
      <view class="hero-tags">
        <text class="hero-tag">{{detail.type || '促销'}}</text>
        <text class="hero-tag status">{{detail.status_text}}</text>
      </view>
      <view wx:if="{{detail.description || detail.rule}}" class="hero-desc">
        {{detail.description || detail.rule}}
      </view>
      <view class="hero-time">
        <mp-icon name="clock" size="13" color="rgba(255,255,255,.85)"></mp-icon>
        <text class="hero-time-text">{{detail.start_time}} ~ {{detail.end_time}}</text>
      </view>
    </view>

    <!-- 促销商品 -->
    <view class="sec">
      <view class="sec-title">促销商品</view>
      <view wx:if="{{items.length}}" class="goods-list">
        <view wx:for="{{items}}" wx:key="id" class="goods-item" data-id="{{item.item_id}}" bindtap="onTapItem">
          <image wx:if="{{item.group_img}}" class="goods-img" src="{{item.group_img}}" mode="aspectFill"></image>
          <view wx:else class="goods-img goods-img-empty">
            <mp-icon name="image" size="20" color="#c0c4cc"></mp-icon>
          </view>
          <view class="goods-info">
            <view class="goods-name">{{item.name || '促销商品'}}</view>
            <view class="goods-desc">{{item.description || item.expression || ''}}</view>
            <view class="goods-status">{{item.is_close ? '已结束' : '促销中'}}</view>
          </view>
        </view>
      </view>
      <empty wx:else text="该活动暂无促销商品"></empty>
    </view>
  </block>

  <empty wx:if="{{!detail && !loading}}" text="活动不存在或已结束"></empty>
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
</view>
