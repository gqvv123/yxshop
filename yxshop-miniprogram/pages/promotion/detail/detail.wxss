.page { min-height: 100vh; background: #f5f6f8; padding-bottom: 30rpx; }
.hero {
  background: linear-gradient(135deg, #ff7a45, #ff4d4f);
  padding: 40rpx 32rpx 36rpx; color: #fff;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-tags { display: flex; gap: 12rpx; margin-top: 18rpx; }
.hero-tag {
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.25);
}
.hero-tag.status { background: #fff; color: #ff4d4f; }
.hero-desc { font-size: 26rpx; margin-top: 18rpx; line-height: 1.6; opacity: .92; }
.hero-time { display: flex; align-items: center; gap: 6rpx; margin-top: 16rpx; }
.hero-time-text { font-size: 22rpx; opacity: .9; }
.sec { margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: #222; margin-bottom: 16rpx; }
.goods-item { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.goods-item:last-child { border-bottom: none; }
.goods-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f7f8fa; }
.goods-img-empty { display: flex; align-items: center; justify-content: center; }
.goods-info { flex: 1; overflow: hidden; }
.goods-name { font-size: 28rpx; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-desc { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.goods-status { font-size: 22rpx; color: #ff5b28; margin-top: 8rpx; }
.loading-tip { text-align: center; font-size: 24rpx; color: #999; padding: 40rpx 0; }
